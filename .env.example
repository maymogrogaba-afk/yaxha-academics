# Yaxha Academics configuration. Copy this file to .env and fill in the values.
# Never commit .env. Every value here stays on the server; none is sent to the browser.

# --- Required -------------------------------------------------------------
# PostgreSQL connection string (local Postgres or Supabase).
# Supabase: Project Settings > Database > Connection string > "Transaction pooler" (port 6543).
DATABASE_URL=postgres://yaxha:yaxha@localhost:5432/yaxha

# The address people use to open the app, without a trailing slash.
# Local: http://localhost:3000   Online: https://your-app.vercel.app
APP_URL=http://localhost:3000

# 64 hex characters used to encrypt Google tokens in the database.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# --- Google Classroom (optional; the app works without it) ---------------
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI must be exactly: {APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI (optional; summaries, quizzes, flashcards and the tutor need it) ---
# AI_PROVIDER is "anthropic" (default) or "openai" (any OpenAI-compatible API).
AI_PROVIDER=anthropic
AI_API_KEY=
# Leave empty for the default (claude-opus-5-5). Lower-cost options: claude-sonnet-5-5, claude-haiku-5-5.
# Required when AI_PROVIDER=openai.
AI_MODEL=
# Only for OpenAI-compatible providers or a proxy. Leave empty for Anthropic.
AI_BASE_URL=
# Budget guard: maximum AI requests per user per hour.
AI_MAX_REQUESTS_PER_HOUR=30
# Characters of source text sent per request before long sources are processed in parts.
AI_MAX_SOURCE_CHARS=60000

# --- Limits and access -----------------------------------------------------
MAX_UPLOAD_MB=15
# Set to false after creating your own account to stop strangers signing up.
ALLOW_SIGNUP=true
# Files downloaded from Drive per sync (more are fetched on the next sync).
SYNC_MAX_DOWNLOADS=15
SYNC_MAX_UPDATE_CHECKS=40
DATABASE_POOL_SIZE=5
